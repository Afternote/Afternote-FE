<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Compose/일반 Activity용 (스플래시 이후 postSplashScreenTheme) -->
    <style name="Theme.Afternotefe.Main" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 런처(MainActivity) 전용: Theme.SplashScreen + installSplashScreen() -->
    <style name="Theme.Afternotefe.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Afternotefe.Main</item>
        <!--
            Theme.SplashScreen 은 DayNight 라 night 에서 isLightTheme=false 로 떨어지는데
            windowSplashScreenBackground 는 #FAFAFA 고정이다. 그대로 두면 다크 기기에서
            밝은 스플래시 위에 흰 시스템바 아이콘이 얹혀 보이지 않는다 — 앱이 라이트로
            잠긴 동안은(#1719) 배경과 아이콘을 같은 쪽으로 맞춘다. 다크 팔레트를 되살릴 때
            AfternoteTheme 의 isDarkTheme·enableLightEdgeToEdge 와 함께 되돌린다.
        -->
        <!-- windowLightNavigationBar 는 API 27+ 라 values-v27/ 에 둔다 (minSdk 26). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>