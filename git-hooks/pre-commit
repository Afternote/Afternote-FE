#!/bin/sh
# Afternote-FE: pre-commit hook.
# Install once: ./gradlew installGitHooks
#
# Staged 파일만 ktlint 로 검사·포맷한다. CI 의 ScaCap/action-ktlint 가 사용하는
# ktlint 1.8.0 standalone binary 를 동일하게 호출하므로 검사 범위·결과가 CI 와
# 일치 (PR diff 라인 ≒ staged 라인).
#
# Gradle 의 ktlintFormat / ktlintCheck task 는 의도적으로 호출하지 않는다 —
# 프로젝트 전체를 대상으로 돌면서 CI 가 안 잡던 옛 위반들까지 working tree 로
# 끌어내는 부작용이 있어 폐기.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|kts)$' || true)
[ -z "$STAGED_KT" ] && exit 0

# CI(ScaCap/action-ktlint)에 핀된 버전과 일치. libs.versions.toml 의 `ktlint = "1.8.0"`.
KTLINT_VERSION="1.8.0"
KTLINT="$ROOT/.git/hooks/.ktlint-${KTLINT_VERSION}"

if [ ! -x "$KTLINT" ]; then
    echo "Downloading ktlint ${KTLINT_VERSION}..."
    curl -fsSLo "$KTLINT" "https://github.com/pinterest/ktlint/releases/download/${KTLINT_VERSION}/ktlint"
    chmod +x "$KTLINT"
fi

echo "Running ktlint --format on staged files..."
echo "$STAGED_KT" | xargs "$KTLINT" --format --relative

# 자동 포맷된 staged 파일만 re-stage (다른 modified 파일은 끌어들이지 않음)
echo "$STAGED_KT" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$f" ] || continue
    git add -- "$f"
done

echo "Running ktlint --relative on staged files..."
echo "$STAGED_KT" | xargs "$KTLINT" --relative
