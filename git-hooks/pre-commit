#!/bin/sh
# Afternote-FE: pre-commit hook.
# Install once: ./gradlew installGitHooks
#
# Staged 파일만 ktlint 로 검사·포맷한다. CI 의 ScaCap/action-ktlint 가 사용하는
# ktlint 1.8.0 standalone binary 를 동일하게 호출하므로 검사 범위·결과가 CI 와
# 일치 (PR diff 라인 ≒ staged 라인).
#
# Gradle 의 ktlintFormat / ktlintCheck task 는 의도적으로 호출하지 않는다 —
# 프로젝트 전체를 대상으로 돌면서 CI 가 안 잡던 옛 위반들까지 working tree 로
# 끌어내는 부작용이 있어 폐기.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|kts)$' || true)
[ -z "$STAGED_KT" ] && exit 0

# CI(ScaCap/action-ktlint)에 핀된 버전과 일치. libs.versions.toml 의 `ktlint = "1.8.0"`.
KTLINT_VERSION="1.8.0"
# worktree 에서는 $ROOT/.git 이 디렉터리가 아니라 gitdir 포인터 파일이라
# "$ROOT/.git/hooks/..." 경로가 성립하지 않는다. 캐시는 항상 공용 hooks
# 디렉터리(메인 저장소의 .git/hooks) 기준으로 잡는다.
HOOKS_DIR="$(cd "$(git rev-parse --git-common-dir)/hooks" && pwd)"
KTLINT="$HOOKS_DIR/.ktlint-${KTLINT_VERSION}"

if [ ! -x "$KTLINT" ]; then
    echo "Downloading ktlint ${KTLINT_VERSION}..."
    curl -fsSLo "$KTLINT" "https://github.com/pinterest/ktlint/releases/download/${KTLINT_VERSION}/ktlint"
    chmod +x "$KTLINT"
fi

FULLY_STAGED=$(
    echo "$STAGED_KT" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        if git diff --quiet -- "$f"; then
            printf '%s\n' "$f"
        fi
        :
    done
)
PARTIALLY_STAGED=$(
    echo "$STAGED_KT" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        if ! git diff --quiet -- "$f"; then
            printf '%s\n' "$f"
        fi
        :
    done
)

if [ -n "$FULLY_STAGED" ]; then
    echo "Running ktlint --format on fully staged files..."
    # 전체가 staged 된 파일만 포맷 후 다시 stage 한다. 부분 staged 파일을 git add 하면
    # 사용자가 제외한 hunk 까지 커밋에 포함되므로 아래 staged-content 검사 경로로 분리한다.
    printf '%s\n' "$FULLY_STAGED" | tr '\n' '\0' | xargs -0 "$KTLINT" --format --relative
    printf '%s\n' "$FULLY_STAGED" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        [ -f "$f" ] || continue
        git add -- "$f"
    done
fi

FAILED=0

if [ -n "$FULLY_STAGED" ]; then
    echo "Running ktlint check on fully staged files..."
    if ! printf '%s\n' "$FULLY_STAGED" | tr '\n' '\0' | xargs -0 "$KTLINT" --relative; then
        FAILED=1
    fi
fi

if [ -n "$PARTIALLY_STAGED" ]; then
    echo "Running ktlint check on partially staged content..."
    if ! printf '%s\n' "$PARTIALLY_STAGED" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        git show ":$f" | "$KTLINT" --stdin --stdin-path="$f" --relative || exit 1
    done; then
        FAILED=1
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo ""
    echo "✗ ktlint 위반이 남았습니다."
    echo "  → 부분 staged 파일은 선택하지 않은 변경을 보호하기 위해 자동 포맷하지 않습니다."
    echo "  → 위 출력의 파일·라인을 수동 수정한 뒤 필요한 hunk 만 다시 선택해 커밋하세요."
    exit 1
fi
