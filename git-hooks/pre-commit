#!/bin/sh
# Afternote-FE: pre-commit hook.
# Install once: ./gradlew installGitHooks
#
# Git index 의 staged 스냅샷만 ktlint 로 검사한다. CI 의 ScaCap/action-ktlint 가
# 사용하는 ktlint 1.8.0 standalone binary 를 동일하게 호출하므로 검사 범위·결과가
# 일치한다. Working tree 를 포맷하거나 다시 stage 하지 않아 같은 파일의 일부만
# 커밋하는 경우에도 unstaged 변경을 검사·포함하지 않는다.
#
# 자동 포맷은 의도적으로 수행하지 않는다. 훅에서 전체 파일을 포맷한 뒤 git add 하면
# 같은 파일의 unstaged hunk 까지 커밋에 포함될 수 있기 때문이다.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

TEMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/afternote-ktlint.XXXXXX")
SNAPSHOT_DIR="$TEMP_ROOT/index"
STAGED_LIST="$TEMP_ROOT/staged-kotlin-files"
cleanup() {
    rm -rf -- "$TEMP_ROOT"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# NUL 구분 목록으로 공백과 개행을 포함한 파일명도 그대로 처리한다.
git diff --cached --name-only -z --diff-filter=ACMR -- '*.kt' '*.kts' > "$STAGED_LIST"
[ -s "$STAGED_LIST" ] || exit 0

# CI(ScaCap/action-ktlint)에 핀된 버전과 일치. libs.versions.toml 의 `ktlint = "1.8.0"`.
KTLINT_VERSION="1.8.0"
# worktree 에서는 $ROOT/.git 이 디렉터리가 아니라 gitdir 포인터 파일이라
# "$ROOT/.git/hooks/..." 경로가 성립하지 않는다. 캐시는 항상 공용 hooks
# 디렉터리(메인 저장소의 .git/hooks) 기준으로 잡는다.
HOOKS_DIR="$(cd "$(git rev-parse --git-common-dir)/hooks" && pwd)"
KTLINT="$HOOKS_DIR/.ktlint-${KTLINT_VERSION}"

if [ ! -x "$KTLINT" ]; then
    echo "Downloading ktlint ${KTLINT_VERSION}..."
    curl -fsSLo "$KTLINT" "https://github.com/pinterest/ktlint/releases/download/${KTLINT_VERSION}/ktlint"
    chmod +x "$KTLINT"
fi

mkdir "$SNAPSHOT_DIR"
git checkout-index --all --prefix="$SNAPSHOT_DIR/"

echo "Running ktlint check on staged snapshot..."
if ! (
    cd "$SNAPSHOT_DIR" || exit 1
    xargs -0 "$KTLINT" --relative -- < "$STAGED_LIST"
); then
    echo ""
    echo "✗ 커밋할 스냅샷에 ktlint 위반이 있습니다."
    echo "  → working tree 의 해당 파일을 수정한 뒤 필요한 hunk 만 다시 stage 하세요."
    echo "  → 훅은 working tree 와 staging area 를 변경하지 않았습니다."
    exit 1
fi
